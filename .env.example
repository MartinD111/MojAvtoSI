# ─── Frontend (Vite) public env ─────────────────────────────────────────────
# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser.
# These are all PUBLIC values (anon keys / public URLs) — no secrets here.

# Fastify API (AWS ECS Fargate)
VITE_API_BASE_URL=http://localhost:8080

# Supabase (DB + Auth) — anon key only; RLS protects data
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Typesense search node (search-only key is fetched at runtime from the API)
VITE_TYPESENSE_HOST=YOUR-CLUSTER.a1.typesense.net
VITE_TYPESENSE_PORT=443
VITE_TYPESENSE_PROTOCOL=https

# Observability
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Cloudflare R2 public CDN base for images
VITE_R2_PUBLIC_BASE_URL=https://cdn.mojavto.si

# Cloudflare Turnstile site key (public). Also enable Turnstile in the Supabase
# dashboard (Auth → Attack Protection) so login/register use the same key.
VITE_TURNSTILE_SITE_KEY=
