{
  "name": "mojavto",
  "version": "1.0.0",
  "description": "Slovenian car marketplace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:navtika": "cross-env VITE_PLATFORM=navtika vite",
    "build": "npm run build:all && node scripts/assemble-pages.js",
    "build:avto": "cross-env VITE_PLATFORM=avto vite build",
    "build:navtika": "cross-env VITE_PLATFORM=navtika vite build",
    "build:all": "npm run build:avto && npm run build:navtika",
    "preview": "vite preview --outDir dist-avto",
    "preview:navtika": "vite preview --outDir dist-navtika",
    "lint": "eslint src main.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/browser": "^8.40.0",
    "@supabase/supabase-js": "^2.46.1",
    "firebase": "^11.10.0",
    "jspdf": "^4.2.1",
    "posthog-js": "^1.181.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.14.2",
    "signature_pad": "^5.1.3",
    "typesense": "^1.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfab/MojAvto.git"
  },
  "license": "ISC"
}
