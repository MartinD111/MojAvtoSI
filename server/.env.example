# ─── MojAvto / MojaNavtika API server ───────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000,https://mojavto.si,https://mojanavtika.si

# ─── Supabase (DB + Auth) ───────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ─── Upstash Redis (rate limiting) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare R2 (public images) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mojavto-images
R2_PUBLIC_BASE_URL=https://cdn.mojavto.si

# ─── AWS S3 (private system storage) ────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=mojavto-system

# ─── Typesense (search) ─────────────────────────────────────────────────────
TYPESENSE_HOST=YOUR-CLUSTER.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_ADMIN_API_KEY=
TYPESENSE_SEARCH_ONLY_API_KEY=

# ─── Resend (email) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_AVTO=MojAvto.si <info@mojavto.si>
RESEND_FROM_NAVTIKA=MojaNavtika.si <info@mojanavtika.si>

# ─── Sentry (errors) ────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── PostHog (server-side analytics) ────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Cloudflare Turnstile (anti-bot) ────────────────────────────────────────
# Server secret key. Leave empty in dev to disable verification.
TURNSTILE_SECRET_KEY=

# ─── Webhook signing secrets (#15) ──────────────────────────────────────────
# Resend uses Svix-style signatures (whsec_...). Stripe etc. add their own here.
RESEND_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── Stripe payments + Connect (auction escrow) ─────────────────────────────
# Secret API key (sk_...). Empty → payment endpoints return 503 (dev).
STRIPE_SECRET_KEY=
# Buyer's premium fraction on the winning price (0.03 = 3 %).
AUCTION_BUYER_PREMIUM=0.03
# Hours the buyer's payment is held in escrow before auto-release to the seller.
AUCTION_ESCROW_HOURS=48

# ─── Internal cron auth ─────────────────────────────────────────────────────
# Shared secret the scheduler sends as X-Cron-Secret to POST /internal/cron/*.
# Empty → those routes are disabled (503).
CRON_SECRET=
