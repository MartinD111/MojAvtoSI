{
  "name": "mojavto-server",
  "version": "0.1.0",
  "private": true,
  "description": "MojAvto.si / MojaNavtika.si API — Fastify on AWS ECS Fargate",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:sql": "node scripts/check-no-raw-sql.mjs",
    "typesense:sync": "tsx src/scripts/syncTypesense.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.1",
    "@sentry/node": "^8.40.0",
    "@supabase/supabase-js": "^2.46.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "fastify": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "jose": "^5.9.6",
    "posthog-node": "^4.2.1",
    "resend": "^4.0.1",
    "stripe": "^17.7.0",
    "typesense": "^1.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
