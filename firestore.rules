rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isModerator() {
      return isSignedIn() && (userRole() == 'admin' || userRole() == 'moderator');
    }

    function isEditor() {
      return isSignedIn() && (userRole() == 'admin' || userRole() == 'editor');
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      // Users write their own doc; admins write any
      allow write: if (isSignedIn() && uid() == userId) || isAdmin();
    }

    // ── Listings ──────────────────────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == uid();
      // Author can update their own; moderators/admins can update any
      allow update: if (isSignedIn() && resource.data.authorId == uid())
                    || isModerator();
      allow delete: if (isSignedIn() && resource.data.authorId == uid())
                    || isModerator();
    }

    // ── Brands (taxonomy) ─────────────────────────────────────────────────────
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ── Models (taxonomy) ─────────────────────────────────────────────────────
    match /models/{modelId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Signed-in users can create reports
      allow create: if isSignedIn()
        && request.resource.data.reporterId == uid();
      // Moderators can read and update (resolve/dismiss)
      allow read, update: if isModerator();
      allow delete: if isAdmin();
    }

    // ── Audit log ─────────────────────────────────────────────────────────────
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isModerator();
      allow update, delete: if false; // immutable
    }

    // ── Site config ───────────────────────────────────────────────────────────
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── SEO pages ─────────────────────────────────────────────────────────────
    match /seoPages/{pageId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ── Payments ──────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Users read their own payments; admins read all
      allow read: if (isSignedIn() && resource.data.userId == uid()) || isAdmin();
      // Only backend (Cloud Functions) writes payments — deny direct client writes
      allow write: if false;
    }

    // ── Search logs (analytics) ───────────────────────────────────────────────
    match /searchLogs/{logId} {
      allow read: if isModerator();
      // Written by client on every search — any auth or guest
      allow create: if true;
      allow update: if true;  // increment counter
      allow delete: if isAdmin();
    }

    // ── Favourites (liked listings) ───────────────────────────────────────────
    match /users/{userId}/favourites/{listingId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ── Garages (personal vehicle tracker) ───────────────────────────────────
    match /garages/{userId}/cars/{carId} {
      allow read: if resource.data.isPublic == true
        || (isSignedIn() && uid() == userId);
      allow write: if isSignedIn() && uid() == userId;
    }

    // ── Reviews ───────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == uid()
        && request.resource.data.sellerId != uid();
      allow update: if isSignedIn() && resource.data.authorId == uid();
      allow delete: if (isSignedIn() && resource.data.authorId == uid())
                    || isModerator();
    }

    // ── Saved searches ────────────────────────────────────────────────────────
    match /savedSearches/{searchId} {
      allow read, write: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() && request.resource.data.userId == uid();
    }

    // ── Tire orders ───────────────────────────────────────────────────────────
    match /tire_orders/{orderId} {
      // Buyer creates and reads their own orders
      allow create: if isSignedIn() && request.resource.data.buyerId == uid();
      allow read: if isSignedIn() &&
                     (resource.data.buyerId == uid() ||
                      resource.data.vulcanizerId == uid());
      // Vulcanizer confirms (status → confirmed, bookingUrl set)
      allow update: if isSignedIn() && resource.data.vulcanizerId == uid();
    }

    // ── Parts & tires price-comparison catalog ────────────────────────────────
    // Public read; editors/admins write manually. The future webscraping backend
    // writes via the Admin SDK (service account), which bypasses these rules.
    match /partsCatalog/{productId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ── Webscraping approved sources (allowlist) ──────────────────────────────
    // Admin-only. The backend crawler only scrapes domains where approved == true.
    match /scrapingSources/{sourceId} {
      allow read, write: if isAdmin();
    }

    // ── Auctions (dražbe) ─────────────────────────────────────────────────────
    // The auction state doc lives at auctions/{listingId} (1:1 with the listing).
    // Bidding integrity is enforced best-effort here; the authoritative close and
    // winner selection happen in a Cloud Function — see docs/AUCTIONS_HANDOFF.md.
    match /auctions/{listingId} {
      allow read: if true;
      // Only the listing's author (the seller) creates the auction doc.
      allow create: if isSignedIn() && request.resource.data.sellerId == uid();

      // Seller (or moderator) may change status / contract / payment fields.
      // Any signed-in non-seller may push a higher bid: the new currentBid must
      // strictly exceed the old one and bidCount must increase by exactly 1.
      allow update: if isModerator()
        || (isSignedIn() && resource.data.sellerId == uid())
        || (
            isSignedIn()
            && resource.data.sellerId != uid()
            && resource.data.status == 'active'
            && request.resource.data.currentBidEur > resource.data.currentBidEur
            && request.resource.data.currentBidderId == uid()
            && request.resource.data.bidCount == resource.data.bidCount + 1
            // immutable fields the bidder must not touch
            && request.resource.data.sellerId == resource.data.sellerId
            && request.resource.data.startPriceEur == resource.data.startPriceEur
            && request.resource.data.status == resource.data.status
        );
      allow delete: if isModerator()
                    || (isSignedIn() && resource.data.sellerId == uid());

      // ── Bids ────────────────────────────────────────────────────────────────
      match /bids/{bidId} {
        allow read: if true;
        // A signed-in user may create their own bid; cannot bid on own auction.
        allow create: if isSignedIn()
          && request.resource.data.bidderId == uid()
          && get(/databases/$(database)/documents/auctions/$(listingId)).data.sellerId != uid();
        // Bids are immutable once placed. Cleanup (signature pruning) is backend-only.
        allow update, delete: if isModerator();
      }
    }

    // ── Auction alerts (newsletter opt-in) ────────────────────────────────────
    // Anyone (incl. guests) can subscribe an email. Owners/admins read & remove.
    match /auctionAlerts/{alertId} {
      allow create: if true;
      allow read: if isModerator()
        || (isSignedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == uid());
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
